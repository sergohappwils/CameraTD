-- ==================== 11. CENTRAL SUPERVISOR LOOP ====================
task.spawn(function()
    local lastBlockedWaveLog = 0
    local lastPlayAgainAttempt = 0

    while Controller.Running and gui.Parent do
        local isOver = isGameOver()
        local isVoting = isVotingActive()
        local isPlaying = isMatchActive()
        local curWave = tonumber(workspace:GetAttribute("Wave")) or 0

        if S.syncSkipMultiAcc and isfile and readfile then
            pcall(function()
                if isfile(SHARED_SKIP_FILE) and not skipBox:IsFocused() then
                    local diskVal = readfile(SHARED_SKIP_FILE)
                    if type(diskVal) == "string" and diskVal ~= S.noSkipWaves then
                        S.noSkipWaves = diskVal
                        skipBox.Text = diskVal
                    end
                end
            end)
        end

        if EngineReady then
            -- 1. Game Speed Enforcer
            if S.autoSpeed and isPlaying and Remotes.ChangeSpeed then
                local curSpeed = workspace:GetAttribute("GameSpeed")
                if curSpeed ~= S.speedChoice then
                    pcall(function() Remotes.ChangeSpeed:InvokeServer(S.speedChoice) end)
                end
            end

            -- 2. Gamemode Auto-Vote
            if S.autoVoteMode and isVoting and Remotes.ModeVote then
                local votersRaw = workspace:GetAttribute(S.selectedMode .. "Voters")
                local alreadyVoted = false
                if votersRaw and votersRaw ~= "" then
                    local ok, voters = pcall(function() return HttpService:JSONDecode(votersRaw) end)
                    if ok and type(voters) == "table" and table.find(voters, LP.UserId) then
                        alreadyVoted = true
                    end
                end
                if not alreadyVoted then
                    pcall(function() Remotes.ModeVote:FireServer(S.selectedMode) end)
                    addLog("🗳️ Voted Mode: " .. S.selectedMode, C.Ok)
                end
            end

            -- 3. Wave Skip Enforcer
            if S.autoSkip and isPlaying and Remotes.WaveSkip then
                if workspace:GetAttribute("CanSkip") == true then
                    if isWaveSkipBlocked(curWave, S.noSkipWaves) then
                        if lastBlockedWaveLog ~= curWave then
                            lastBlockedWaveLog = curWave
                            addLog(string.format("🛑 Auto-Skip paused on Wave %d (Filter: %s)", curWave, S.noSkipWaves), C.Gold)
                        end
                    else
                        pcall(function() Remotes.WaveSkip:FireServer() end)
                    end
                end
            end

            -- 4. Verified Auto Play Again (Checks PlayAgainVoters so it never cancels or misses)
            if isOver then
                if S.autoExecute and not S.teleportQueued then
                    armAutoExecute(false)
                end
                if S.autoReplay and Remotes.PlayAgain and not hasVotedPlayAgain() then
                    if tick() - lastPlayAgainAttempt >= 1.0 then
                        lastPlayAgainAttempt = tick()
                        pcall(function() Remotes.PlayAgain:FireServer() end)
                        addLog("⚡ [AutoReplay] Sent PlayAgain Vote!", C.Ok)
                    end
                end
            end

            -- 5. Interruption Watchdog
            if not isPlaying and S.replaying then
                S.replaying = false
                S.paused = false
                table.clear(ReplayTowers)
                table.clear(ActiveTowerLevels)
                timelineDirty = true
                addLog("⏹ Replay Reset: Match transitioned to Voting/Lobby.", C.Gold)
            end

            -- 6. AutoPlay Trigger on Wave >= 1
            if S.autoPlay and isPlaying and curWave >= 1 and not S.replaying and not S.recording and not S.macroPlayed then
                S.macroPlayed = true
                task.spawn(function()
                    task.wait(1.2)
                    if S.autoPlay and isMatchActive() and not S.replaying and Controller.Running then
                        local d = S.macro
                        if not d or not d.actions or #d.actions == 0 then
                            loadMacroByName(S.macroName)
                            d = S.macro
                        end
                        if d and d.actions and #d.actions > 0 then
                            addLog("🤖 [AutoPlay] Starting Macro: " .. (d.name or S.macroName), C.Acc)
                            executeReplay(d, statusLabel)
                        end
                    end
                end)
            end

            if not isPlaying or curWave == 0 then
                S.macroPlayed = false
            end
        end

        local curCash = getCash()
        local curPlaced = LP:FindFirstChild("PlacedTowers") and LP.PlacedTowers.Value or 0
        local basePart = gameFolder and gameFolder:FindFirstChild("Base")
        local baseHp = basePart and basePart:GetAttribute("Health") or 1000
        local baseMax = basePart and basePart:GetAttribute("MaxHealth") or 1000
        local skipBlocked = isWaveSkipBlocked(curWave, S.noSkipWaves)
        telemetryLabel.Text = string.format("Wave: %d%s | Cash: $%d | Units: %d/15 | Base: %d/%d", curWave, skipBlocked and " [NO-SKIP]" or "", curCash, curPlaced, baseHp, baseMax)

        if not S.replaying and not S.recording then
            if isOver then
                statusLabel.Text = hasVotedPlayAgain() and "🏁 Play Again Voted! Waiting..." or "🏁 Match Concluded (Voting Play Again...)"
                statusLabel.TextColor3 = C.Gold
            elseif isVoting then
                statusLabel.Text = "🗳️ Voting Gamemode (" .. S.selectedMode .. ")"
                statusLabel.TextColor3 = C.Acc
            elseif curWave == 0 then
                statusLabel.Text = "⏳ Intermission (Wave 0 Gate Active)"
                statusLabel.TextColor3 = C.Gold
            elseif isPlaying then
                statusLabel.Text = "🎮 Match Active | Cash: $" .. curCash
                statusLabel.TextColor3 = C.Ok
            end
        end

        local ac = (#recData.actions > 0 and #recData.actions) or (S.macro and S.macro.actions and #S.macro.actions) or 0
        actCountLbl.Text = string.format("Profile: %s (%d Acts) | Step: %d/%d", S.macroName, ac, S.currentStepIndex, S.totalSteps)

        g_repB.Text = S.replaying and "⏹ STOP REPLAY" or "▶ REPLAY"
        g_repB.BackgroundColor3 = S.replaying and C.Bad or C.Acc
        g_pauseB.Text = S.paused and "▶ RESUME" or "⏸ PAUSE"
        g_pauseB.BackgroundColor3 = S.paused and C.Gold or C.Bg3

        if fileListDirty then fileListDirty = false pcall(renderMacroFileList) end
        if timelineDirty then timelineDirty = false pcall(renderActionTimeline) end

        if logDirty then
            logDirty = false
            logBox:ClearAllChildren()
            local lLayout = Instance.new("UIListLayout", logBox)
            lLayout.SortOrder = Enum.SortOrder.LayoutOrder
            lLayout.Padding = UDim.new(0, 2)
            local lPad = Instance.new("UIPadding", logBox)
            lPad.PaddingTop = UDim.new(0, 4)
            lPad.PaddingLeft = UDim.new(0, 4)

            for idx, entry in ipairs(logEntries) do
                local line = Instance.new("TextLabel", logBox)
                line.Size = UDim2.new(1, -6, 0, 12)
                line.BackgroundTransparency = 1
                line.Text = entry.t
                line.TextColor3 = entry.c
                line.TextSize = 8
                line.Font = Enum.Font.Code
                line.TextXAlignment = Enum.TextXAlignment.Left
                line.LayoutOrder = idx
            end
        end

        task.wait(0.2)
    end
end)
