local function saveCurrentMacro(name)
    if name == "" then return false end
    local actionsToSave = (#recData.actions > 0 and recData.actions) or (S.macro and S.macro.actions) or {}
    if #actionsToSave == 0 then
        addLog("⚠️ Cannot save an empty macro (0 actions).", C.Gold)
        return false
    end
    S.macroName = name
    nb.Text = name
    saveS()
    local payload = { name = name, date = os.date(), actions = actionsToSave }
    S.macro = payload
    recData.actions = table.clone(actionsToSave)
    local ok = saveJSON(MACRO_FOLDER .. "/" .. name .. ".json", payload)
    fileListDirty = true
    timelineDirty = true
    if ok then addLog(string.format("💾 Saved '%s' (%d actions)", name, #actionsToSave), C.Ok) end
    return ok
end

local function loadMacroByName(name)
    if name == "" then return false end
    local d = loadJSON(MACRO_FOLDER .. "/" .. name .. ".json")
    if d and type(d.actions) == "table" then
        S.macro = d
        recData.actions = table.clone(d.actions)
        S.macroName = name
        nb.Text = name
        saveS()
        timelineDirty = true
        fileListDirty = true
        addLog(string.format("📂 Loaded '%s' (%d actions)", name, #d.actions), C.Ok)
        return true
    end
    return false
end

