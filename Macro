-- CAMERA TD // UNIVERSAL HUB LOADER (v6.0)
-- Repo: https://github.com/sergohappwils/CameraTD
-- Automatically detects Lobby vs. Match (any map) with Offline Cache Fallback
-- ============================================================================

if not game:IsLoaded() then
    game.Loaded:Wait()
end

local REPO_BASE   = "https://raw.githubusercontent.com/sergohappwils/CameraTD/refs/heads/main/"
local LOADER_URL  = REPO_BASE .. "Macro"
local LOBBY_URL   = REPO_BASE .. "Lobby.lua"
local MATCH_URL   = REPO_BASE .. "Match.lua"

local FOLDER      = "CameraTD_Macro"
local DELAY_FILE  = FOLDER .. "/startup_delay.txt"
local CACHE_DIR   = FOLDER .. "/cache"
local LOADER_CACHE = CACHE_DIR .. "/loader_cache.luau"
local LOBBY_CACHE  = CACHE_DIR .. "/lobby_cache.luau"
local MATCH_CACHE  = CACHE_DIR .. "/match_cache.luau"

pcall(function()
    if makefolder and isfolder then
        if not isfolder(FOLDER) then makefolder(FOLDER) end
        if not isfolder(CACHE_DIR) then makefolder(CACHE_DIR) end
    end
end)

-- 1. Read user-configured startup delay (Default: 7s)
local bootDelay = 7
pcall(function()
    if isfile and readfile and isfile(DELAY_FILE) then
        local num = tonumber(readfile(DELAY_FILE):match("([%d%.]+)"))
        if num and num >= 1 and num <= 60 then
            bootDelay = num
        end
    end
end)

task.wait(bootDelay)

local Players = game:GetService("Players")
local LP = Players.LocalPlayer or Players.PlayerAdded:Wait()

-- 2. Arm queue_on_teleport immediately so every teleport re-runs the Loader
local ENV = (getgenv and getgenv()) or _G
local function armTeleportQueue()
    if ENV.__CAM_TD_TP_ARMED then return end
    local qFunc = queue_on_teleport
        or queueonteleport
        or (syn and syn.queue_on_teleport)
        or (fluxus and fluxus.queue_on_teleport)
        or (delta and delta.queue_on_teleport)
        or (ENV and (ENV.queue_on_teleport or ENV.queueonteleport))

    if not qFunc then return end

    local payload = string.format([[
        if not game:IsLoaded() then game.Loaded:Wait() end
        local ok, src = pcall(function()
            return game:HttpGet(%q .. "?t=" .. tostring(os.time()))
        end)
        if ok and type(src) == "string" and #src > 60 then
            if writefile then pcall(writefile, %q, src) end
            local fn = loadstring(src)
            if fn then task.spawn(fn) return end
        end
        if isfile and readfile and isfile(%q) then
            local fn = loadstring(readfile(%q))
            if fn then task.spawn(fn) end
        end
    ]], LOADER_URL, LOADER_CACHE, LOADER_CACHE, LOADER_CACHE)

    if pcall(qFunc, payload) then
        ENV.__CAM_TD_TP_ARMED = true
    end
end

ENV.__CAM_TD_TP_ARMED = false
armTeleportQueue()

-- 3. Wait up to 15s for Workspace / PlayerGui markers so place detection is 100% accurate
local function detectPlaceType()
    local lobbyPlaceId = 132929771812494
    if game.PlaceId == lobbyPlaceId then
        return "LOBBY"
    end

    local deadline = os.clock() + 15
    while os.clock() < deadline do
        if workspace:FindFirstChild("Game") then
            return "MATCH"
        end
        if workspace:FindFirstChild("Elevators") then
            return "LOBBY"
        end
        local pg = LP:FindFirstChildOfClass("PlayerGui")
        if pg then
            if pg:FindFirstChild("GameUI") then return "MATCH" end
            if pg:FindFirstChild("ElevatorGui") then return "LOBBY" end
        end
        task.wait(0.25)
    end

    if workspace:FindFirstChild("Elevators") then
        return "LOBBY"
    end
    return "MATCH"
end

-- 4. Fetch & Execute with Live GitHub + Local Disk Cache Fallback
local function fetchAndExecute(url, cachePath, label)
    local src = nil
    for attempt = 1, 3 do
        local ok, res = pcall(function()
            return game:HttpGet(url .. "?t=" .. tostring(os.time()))
        end)
        if ok and type(res) == "string" and #res > 100 and not res:match("^404:") then
            src = res
            pcall(function()
                if writefile then writefile(cachePath, src) end
            end)
            break
        end
        task.wait(0.8)
    end

    if not src then
        pcall(function()
            if isfile and readfile and isfile(cachePath) then
                local cached = readfile(cachePath)
                if type(cached) == "string" and #cached > 100 then
                    src = cached
                    warn("[CameraTD Loader] GitHub unreachable, loaded cached " .. label)
                end
            end
        end)
    end

    if not src then
        warn("[CameraTD Loader] Failed to load " .. label .. " from " .. url)
        return false
    end

    local fn, err = loadstring(src)
    if not fn then
        warn("[CameraTD Loader] Syntax error in " .. label .. ": " .. tostring(err))
        return false
    end

    print("[CameraTD Loader] Launching " .. label .. "...")
    task.spawn(fn)
    return true
end

local placeType = detectPlaceType()
if placeType == "LOBBY" then
    fetchAndExecute(LOBBY_URL, LOBBY_CACHE, "Lobby Module (Lobby.lua)")
else
    fetchAndExecute(MATCH_URL, MATCH_CACHE, "Match Module (Match.lua)")
end
