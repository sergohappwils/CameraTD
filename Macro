local function armAutoExecute(showLog)
    local qFunc = queue_on_teleport
        or queueonteleport
        or (syn and syn.queue_on_teleport)
        or (fluxus and fluxus.queue_on_teleport)
        or (ENV and (ENV.queue_on_teleport or ENV.queueonteleport))

    if not qFunc then
        if showLog then addLog("❌ Executor missing queue_on_teleport", C.Bad) end
        return false
    end

    if not S.teleportQueued then
        local payload = string.format([[
            if not game:IsLoaded() then game.Loaded:Wait() end
            local ok, src = pcall(function()
                return game:HttpGet(%q .. "?t=" .. tostring(os.time()))
            end)
            if ok and type(src) == "string" and #src > 100 then
                if writefile then pcall(writefile, %q, src) end
                local fn = loadstring(src)
                if fn then task.spawn(fn) return end
            end
            if isfile and readfile and isfile(%q) then
                local fn = loadstring(readfile(%q))
                if fn then task.spawn(fn) end
            end
        ]], GITHUB_URL, AUTOEXEC_FILE, AUTOEXEC_FILE, AUTOEXEC_FILE)

        local ok, err = pcall(qFunc, payload)
        if ok then
            S.teleportQueued = true
            if showLog then addLog("✅ Auto-Execute Armed (GitHub Live + Cache)!", C.Ok) end
            return true
        else
            if showLog then addLog("❌ Auto-Exec Error: " .. tostring(err), C.Bad) end
            return false
        end
    else
        if showLog then addLog("✅ Auto-Execute is already armed for teleport!", C.Ok) end
        return true
    end
end

